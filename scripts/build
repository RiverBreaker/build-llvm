#!/bin/bash
set -euo pipefail
export MSYS_NO_PATHCONV=1
build_dir=""
build_arch=""
build_type=""
build_project=""
install_dir=""
src_dir=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --build-dir=*)
            build_dir="${1#*=}"
            shift
            ;;
        --build-arch=*)
            build_arch="${1#*=}"
            shift
            ;;
        --build-type=*)
            build_type="${1#*=}"
            shift
            ;;
        --build-project=*)
            build_project="${1#*=}"
            shift
            ;;
		--install-dir=*)
			install_dir="${1#*=}"
			shift
			;;
		--src-dir=*)
			src_dir="${1#*=}"
			shift
			;;
        *)
            echo "未知选项: $1"
            exit 1
            ;;
    esac
done

if [[ -z "$build_dir" || -z "$build_arch" || -z "$build_type" || -z "$build_project" || -z "$install_dir" || -z "$src_dir" ]]; then
    echo "[ERROR] 缺少必要参数,请检查 --build-dir --build-arch --build-type --build-project --install-dir --src-dir"
    exit 1
fi
if [[ "$(uname -s)" == MINGW* || "$(uname -s)" == MSYS* ]]; then
    build_dir=$(cygpath -m "$build_dir")
    install_dir=$(cygpath -m "$install_dir")
    src_dir=$(cygpath -m "$src_dir")
else
    # Linux use realpath
    build_dir=$(realpath -m "$build_dir")
    install_dir=$(realpath -m "$install_dir")
    src_dir=$(realpath -m "$src_dir")
fi

if [ ! -d "${install_dir}" ]; then
    mkdir -p "${install_dir}"
fi

if [ -d "${build_dir}" ]; then
	# if [ "${build_project}" != "flang" ]; then
	rm -rf "${build_dir}"
	# fi
fi
mkdir -p "${build_dir}"

cmake_args=()
if [[ "${build_project}" == "base" ]]; then
	will_build="llvm"
	if [[ "${build_type}" == "Release" ]]; then
		# 纯工具链
		cmake_args+=(
			"-DCOMPILER_RT_BUILD_SANITIZERS=OFF"
			"-DCOMPILER_RT_BUILD_XRAY=OFF"
		)
	fi
	cmake_args+=(
        "-DLLVM_ENABLE_PROJECTS=clang;clang-tools-extra"
        "-DLLVM_ENABLE_RUNTIMES=compiler-rt;openmp"
        "-DLLVM_TARGETS_TO_BUILD=${build_arch}"
        "-DCOMPILER_RT_BUILD_LIBFUZZER=OFF"
        "-DCOMPILER_RT_BUILD_ORC=OFF"
        "-DPACKAGE_VENDOR=Build By github@Riverbreaker (https://github.com/RiverBreaker/build-llvm.git)"
        "-DCLANG_VENDOR=github@Riverbreaker (https://github.com/RiverBreaker/build-llvm.git)"
    )
else
	will_build="${build_project}"
	cmake_args+=(
        "-DLLVM_DIR=${install_dir}/lib/cmake/llvm"
        "-DClang_DIR=${install_dir}/lib/cmake/clang"
    )
fi
if [[ "${build_project}" == "flang" ]]; then
	cmake_args+=(
		"-DFLANG_VENDOR=github@Riverbreaker (https://github.com/RiverBreaker/build-llvm.git)"
		"-DMLIR_DIR=${install_dir}/lib/cmake/mlir"
		"-DMLIR_TABLEGEN_EXE=${install_dir}/bin/mlir-tblgen.exe"
	)
fi
if [[ "${build_type}" == "RelWithDebInfo" ]]; then
	cmake_args+=(
		"-DCMAKE_C_FLAGS_RELWITHDEBINFO=/Z7 /O2 /Ob1 /DNDEBUG"
        "-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=/Z7 /O2 /Ob1 /DNDEBUG"
	)
fi
cmake_args+=(
    "-DCMAKE_BUILD_TYPE=${build_type}"
    "-DLLVM_ENABLE_RTTI=OFF"
    "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON"
    "-DLLVM_PARALLEL_LINK_JOBS=4"
    "-DLLVM_INCLUDE_TESTS=OFF"
    "-DCMAKE_MSVC_DEBUG_INFORMATION_FORMAT=Embedded"
    "-DCMAKE_INSTALL_PREFIX=${install_dir}"
    "-DCMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO=/INCREMENTAL:NO"
    "-DCMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO=/INCREMENTAL:NO"
    "-DCMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO=/INCREMENTAL:NO"
    "-DCMAKE_EXE_LINKER_FLAGS=/MANIFEST:NO"
    "-DCMAKE_MODULE_LINKER_FLAGS=/MANIFEST:NO"
    "-DCMAKE_SHARED_LINKER_FLAGS=/MANIFEST:NO"
)

cd "${src_dir}"
echo "::group::${build_project} CMake 配置"
cmake -S "${will_build}" \
	-B "${build_dir}" \
	-G Ninja \
	"${cmake_args[@]}" || { echo "::error::CMake 生成失败"; exit 1; }
echo "::endgroup::"

# ====== 3. 编译 ======
JOBS=$(nproc 2>/dev/null || echo 2)
echo "::group::Ninja 编译 ${build_project} (使用 ${JOBS} 个并发任务)"
ninja -C "${build_dir}" -j"${JOBS}" || { echo "::error::${build_project} 编译失败"; exit 1; }
echo "::endgroup::"
# ====== 4. 安装 ======
echo "::group::Ninja 安装 ${build_project}"
ninja -C "${build_dir}" install && echo "[INFO] ${build_project} 安装完成，目录：${install_dir}" \
	|| { echo "::error::${build_project} 安装失败"; exit 1; }
echo "::endgroup::"

# ====== 5.5 体积优化（可选） ======
echo "::group::[INFO] Cleaning up unnecessary files to reduce package size..."

if [[ "${build_type}" == "Release" ]]; then
	find "${install_dir}" -type f -name "*.pdb" -delete 2>/dev/null || true
	echo "[INFO] PDB files removed for Release build."
else
	echo "[INFO] Keeping PDB files for RelWithDebInfo build."
fi
# mlir-tblgen 不会被 install 规则安装，手动复制给 flang 用
if [[ "${build_project}" == "mlir" ]]; then
    cp -f "${build_dir}/bin/mlir-tblgen.exe" "${install_dir}/bin/"
fi
find "${install_dir}/bin" -type f -name "*Tests.exe" -delete 2>/dev/null || true
echo "::endgroup::[INFO] Cleanup complete."

echo "::group::[INFO] 开始清理构建目录"
# if [ "${build_project}" != "mlir" ]; then
rm -rf "${build_dir}" || { echo "[ERROR] 构建清理失败"; exit 1; }
# fi
echo "[INFO] 清理完成"
echo "::endgroup::"

# if [[ "${build_type}" == "Release" && "${build_project}" == "flang" ]]; then
# 	echo "::group::开始清理mlir的工具和开发库"
#     # mlir 的工具和开发库，工具链用户不需要
#     rm -f "${install_dir}"/bin/mlir-*
#     rm -f "${install_dir}"/bin/tblgen-liblinalg*
#     rm -rf "${install_dir}"/lib/cmake/mlir
#     rm -f "${install_dir}"/lib/libMLIR*.lib
#     rm -f "${install_dir}"/lib/libmlir*.lib
#     rm -rf "${install_dir}"/include/mlir
#     rm -rf "${install_dir}"/include/mlir-c

#     # lldb 对工具链用户也可选（看你要不要留）
#     # rm -f "${install_dir}"/bin/lldb*

#     echo "[INFO] Release toolchain: removed MLIR dev files"
# 	echo "::endgroup::"
# fi
